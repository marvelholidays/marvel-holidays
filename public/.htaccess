<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect www to non-www (or remove if you prefer www)
  RewriteCond %{HTTP_HOST} ^www\.marvelholidays\.in [NC]
  RewriteRule ^(.*)$ https://marvelholidays.in/$1 [L,R=301]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>